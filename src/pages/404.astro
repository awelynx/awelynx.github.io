---
import Base from "../layouts/Base.astro";
// A desk puzzle: ruler, pencil, paper strip and magnifier arranged as "404".
const four = (x) => `
  <g transform="translate(${x} 0)">
    <rect class="ruler" x="128" y="30" width="26" height="250" rx="2"/>
    ${Array.from({ length: 24 }, (_, i) => `<path class="tick" d="M128 ${42 + i * 10}h${i % 5 ? 7 : 13}"/>`).join("")}
    <g transform="rotate(32 30 200)">
      <rect class="pencil" x="40" y="10" width="20" height="200" rx="2"/>
      <path class="pencil-tip" d="M40 210 L50 238 L60 210 Z"/>
      <rect class="eraser" x="40" y="0" width="20" height="14" rx="2"/>
    </g>
    <rect class="paper" x="10" y="190" width="190" height="26" rx="1" transform="rotate(-2 105 203)"/>
  </g>`;
const svg = `
<svg viewBox="0 0 760 320" role="img" aria-labelledby="puzzle-title">
  <title id="puzzle-title">尺子、铅笔、纸条和放大镜摆成的数字 404 · A ruler, pencils, paper strips and a magnifier arranged as 404</title>
  ${four(0)}
  <g class="magnifier">
    <circle cx="380" cy="150" r="88" class="lens"/>
    <circle cx="380" cy="150" r="88" class="rim"/>
    <path class="glint" d="M335 115 a60 60 0 0 1 40 -30"/>
    <rect class="handle" x="372" y="238" width="18" height="76" rx="6"/>
  </g>
  ${four(500)}
</svg>`;
---

<!-- GitHub Pages serves one 404 for every path, so it speaks both languages. -->
<Base title="页面不存在 · Page not found · 林煜轩">
  <section class="wrap not-found">
    <figure class="desk" set:html={svg} />
    <h1>找找这个数字。</h1>
    <p class="lead">
      这个地址没有内容，页面可能已经移动或下线。可以从这些地方继续：
    </p>
    <p class="nf-links">
      <a href="/">首页</a>
      <a href="/work/">作品</a>
      <a href="/writing/">写作</a>
    </p>
    <div lang="en">
      <p class="lead">
        Nothing lives at this address; the page may have moved or been retired.
        Carry on from here:
      </p>
      <p class="nf-links">
        <a href="/en/">Home</a>
        <a href="/en/work/">Work</a>
        <a href="/en/about/">About</a>
      </p>
    </div>
    <p class="nf-return" data-return>
      <span data-return-text>5 秒后回到首页。</span>
      <button type="button" class="link-button" data-return-stop>
        留在这里
      </button>
    </p>
  </section>
  <script>
    // Count down, then go to the home page in the visitor's language. The
    // visitor can stop it; reduced motion does not change it, as it is navigation.
    const box = document.querySelector("[data-return]");
    const text = box.querySelector("[data-return-text]");
    const stop = box.querySelector("[data-return-stop]");
    const en = location.pathname.startsWith("/en/");
    const home = en ? "/en/" : "/";
    const say = (n) =>
      en ? `Going to the home page in ${n} s.` : `${n} 秒后回到首页。`;
    if (en) stop.textContent = "Stay here";
    let n = 5;
    text.textContent = say(n);
    const timer = setInterval(() => {
      n -= 1;
      if (n > 0) text.textContent = say(n);
      else {
        clearInterval(timer);
        location.replace(home);
      }
    }, 1000);
    stop.addEventListener("click", () => {
      clearInterval(timer);
      box.remove();
    });
  </script>
</Base>
