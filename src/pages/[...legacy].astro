---
// Old URLs from earlier versions of the site. Those whose content lives on
// redirect to the current page; the retired archive is gone and falls to 404.
import { oldRoutes } from "../lib/content.mjs";
import redirects from "../../scripts/legacy-redirects.json";
export function getStaticPaths() {
  const routes = new Map(oldRoutes);
  for (const r of redirects) {
    const to = oldRoutes.get(r.to) || r.to;
    if (!routes.has(r.from)) routes.set(r.from, to);
  }
  for (const from of [
    "/blog/archive/",
    "/blog/tags/",
    "/plog/archive/",
    "/plog/tags/",
    "/docs/",
  ])
    routes.set(from, "/writing/");
  const reserved = new Set(["/", "/work/", "/writing/", "/life/", "/about/"]);
  return [...routes]
    .filter(
      ([from, to]) =>
        !/^\/(Doc|CV)(\/|$)/.test(from) &&
        !reserved.has(from) &&
        ![from, to].some((u) => /^\/archive(\/|$)/.test(u)),
    )
    .map(([from, to]) => ({
      params: { legacy: from.replace(/^\//, "").replace(/\/$/, "") },
      props: { to },
    }));
}
const { to } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>内容已移到新位置 · 林煜轩</title>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={new URL(to, "https://awelynx.github.io")} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>
      这篇内容已移到新的位置。<a href={to}>前往新页面</a>
    </p>
  </body>
</html>
